; Engine configuration file.
; Seraph Arena — Angel Arena–inspired arena brawler for Xogot / Godot 4.4

config_version=5

[application]

config/name="Seraph Arena"
config/description="Top-down arena brawler inspired by classic Angel Arena. Farm creeps, buy items, duel for kills — solo vs AI now, online-ready later."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

GameSession="*res://scripts/autoload/game_session.gd"
NetBridge="*res://scripts/autoload/net_bridge.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=1

